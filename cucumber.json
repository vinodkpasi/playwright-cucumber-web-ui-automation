{
  "default": {
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "dryRun": false,
    "tags": "",
    "paths": ["src/features/"],
    "require": ["src/step_definitions/*.ts", "src/hooks/hooks.ts"],
    "requireModule": ["ts-node/register"],
    "format": [
      "progress-bar",
      "json:test-results/cucumber-report.json",
      "rerun:@rerun.txt"
    ],
    "parallel": 3,
    "retry": 1
  },
  "rerun": {
    "formatOptions": {
      "snippetInterface": "async-await"
    },
    "dryRun": false,
    "tags": "",
    "paths": ["src/features/"],
    "require": ["src/step_definitions/*.ts", "src/hooks/hooks.ts"],
    "requireModule": ["ts-node/register"],
    "format": [
      "progress-bar",
      "json:test-results/cucumber-report.json",
      "rerun:@rerun.txt"
    ],
    "parallel": 3,
    "retry": 1
  }
}
